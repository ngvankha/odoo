<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="cons_assitant_ai.ChatbotWidget" owl="1">
        <!-- Floating Button -->
        <div t-if="!state.isOpen" class="o_cons_assistant_ai_floating_button">
            <button class="o_chatbot_toggle" 
                    t-on-click="toggleAssistant"
                    title="Mở AI Assistant">
                <i class="fa fa-comments"></i>
            </button>
        </div>

        <!-- Nút mở AI Assistant trong systray -->
        <div class="o_cons_assitant_ai_systray">
            <button class="btn btn-secondary o_cons_assitant_ai_button" t-on-click="toggleAssistant">
                <i class="fa fa-robot"></i>
                <span class="d-none d-md-inline ms-1">AI Assistant</span>
            </button>
        </div>

        <!-- Cửa sổ AI Assistant -->
        <div t-if="state.isOpen" class="o_cons_assitant_ai_window">
            <div class="o_cons_assitant_ai_header">
                <span class="o_cons_assitant_ai_title">
                    <i class="fa fa-robot me-2"></i>
                    Cons Assistant AI
                    <span t-if="!state.isEnabled" class="badge bg-danger ms-2">Tắt</span>
                    <span t-elif="!state.isConfigured" class="badge bg-warning ms-2">Chưa cấu hình</span>
                    <!-- <span t-else="" class="badge bg-success ms-2">n8n</span> -->
                </span>
                <div class="o_cons_assitant_ai_controls">
                    <!-- <button class="btn btn-sm btn-outline-light me-1"
                    t-on-click="refreshConfiguration" title="Làm mới cấu hình">
                        <i class="fa fa-sync"></i>
                    </button> -->
                    <button class="btn btn-sm btn-outline-light me-1" t-on-click="clearChat" title="Xóa cuộc trò chuyện">
                        <i class="fa fa-refresh"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-light" t-on-click="toggleAssistant" title="Đóng">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
            </div>
            
            <div class="o_cons_assitant_ai_messages">
                <div t-foreach="state.messages" t-as="message" t-key="message_index" 
                     t-attf-class="o_cons_assitant_ai_message {{message.isBot ? 'o_bot_message' : 'o_user_message'}} {{message.isError ? 'o_error_message' : ''}} {{message.isLoading ? 'o_loading_message' : ''}}">
                    <div class="o_message_content">
                        <div t-if="message.isBot" class="d-flex align-items-start">
                            <i t-if="message.isLoading" class="fa fa-spinner fa-spin me-2"></i>
                            <i t-elif="message.isError" class="fa fa-exclamation-triangle me-2"></i>
                            <i t-else="" class="fa fa-robot me-2"></i>
                            <span t-if="message.hasMarkdown" t-out="message.formattedText"></span>
                            <span t-else="" t-esc="message.text"></span>
                        </div>
                        <div t-else="" class="d-flex align-items-start">
                            <span t-if="message.hasMarkdown" t-out="message.formattedText"></span>
                            <span t-else="" t-esc="message.text"></span>
                            <img t-if="state.userAvatar" t-att-src="state.userAvatar" class="o_user_avatar_chatbot ms-2" t-att-alt="state.userName" t-att-title="state.userName" /> 
                            <i t-else="" class="fa fa-user ms-2"></i>
                        </div>
                    </div>
                    <div t-if="message.timestamp &amp;&amp; !message.isLoading" class="o_message_time">
                        <small t-esc="formatTime(message.timestamp)"></small>
                    </div>
                </div>
            </div>
            
            <div class="o_cons_assitant_ai_input">
                <div class="input-group">
                    <input type="text" 
                           class="form-control" 
                           placeholder="Nhập tin nhắn của bạn..."
                           t-model="state.currentMessage"
                           t-on-keypress="onKeyPress"
                           t-att-disabled="state.isLoading or !state.isEnabled" />
                    <button class="btn btn-primary" 
                            t-on-click="sendMessage"
                            t-att-disabled="state.isLoading or !state.isEnabled">
                        <i t-if="state.isLoading" class="fa fa-spinner fa-spin"></i>
                        <i t-else="" class="fa fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>