<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <!-- Chatbot Button Template -->
    <t t-name="odoo_frontend_chatbot.ChatbotButton" owl="1">
        <div class="o_frontend_chatbot_button" t-att-class="state.position" t-if="state.enabled">
            <button class="btn btn-primary o_chatbot_toggle" t-on-click="toggleChat">
                <i class="fa fa-comments" t-if="!state.isOpen"/>
                <i class="fa fa-times" t-if="state.isOpen"/>
            </button>
            <div class="o_chatbot_badge" t-if="state.unreadCount > 0">
                <t t-esc="state.unreadCount"/>
            </div>
        </div>
    </t>

    <!-- Chatbot Window Template -->
    <t t-name="odoo_frontend_chatbot.ChatbotWindow" owl="1">
        <div class="o_frontend_chatbot_window" t-att-class="state.position" t-if="state.isOpen">
            <div class="o_chatbot_header">
                <div class="o_chatbot_title">
                    <i class="fa fa-robot me-2"/>
                    Odoo Assistant
                </div>
                <div class="o_chatbot_controls">
                    <button class="btn btn-sm" t-on-click="minimizeChat">
                        <i class="fa fa-minus"/>
                    </button>
                    <button class="btn btn-sm" t-on-click="closeChat">
                        <i class="fa fa-times"/>
                    </button>
                </div>
            </div>
            
            <div class="o_chatbot_body">
                <div class="o_chatbot_messages" t-ref="messagesContainer">
                    <div t-foreach="state.messages" t-as="message" t-key="message.id" 
                         class="o_chatbot_message" t-att-class="message.isBot ? 'o_bot_message' : 'o_user_message'">
                        <div class="o_message_avatar" t-if="message.isBot">
                            <i class="fa fa-robot"/>
                        </div>
                        <div class="o_message_content">
                            <div class="o_message_body" t-raw="message.body"/>
                            <div class="o_message_time" t-esc="message.time"/>
                        </div>
                        <div class="o_message_avatar" t-if="!message.isBot">
                            <i class="fa fa-user"/>
                        </div>
                    </div>
                    
                    <!-- Typing indicator -->
                    <div class="o_chatbot_message o_bot_message o_typing" t-if="state.isTyping">
                        <div class="o_message_avatar">
                            <i class="fa fa-robot"/>
                        </div>
                        <div class="o_message_content">
                            <div class="o_typing_indicator">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="o_chatbot_composer">
                    <div class="o_composer_input_wrapper">
                        <input type="text" class="form-control o_composer_input" 
                               placeholder="Type your message..." 
                               t-model="state.currentMessage"
                               t-on-keydown="onKeyDown"
                               t-ref="messageInput"/>
                        <button class="btn btn-primary o_send_button" 
                                t-on-click="sendMessage"
                                t-att-disabled="!state.currentMessage.trim()">
                            <i class="fa fa-paper-plane"/>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
