<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_frontend_chatbot" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.frontend.chatbot</field>
        <field name="model">res.config.settings</field>
        <field name="priority">90</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block o_not_app" data-string="Frontend Chatbot" data-key="odoo_frontend_chatbot" groups="base.group_system">
                    <h2>Frontend Chatbot</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="frontend_chatbot_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="frontend_chatbot_enabled"/>
                                <div class="text-muted">
                                    Enable floating chatbot in Odoo frontend interface
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-12 col-lg-6 o_setting_box" invisible="not frontend_chatbot_enabled">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="frontend_chatbot_welcome_message">Welcome Message</label>
                                <field name="frontend_chatbot_welcome_message" placeholder="Enter welcome message..."/>
                                <div class="text-muted">
                                    Message shown when user opens the chatbot
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-12 col-lg-6 o_setting_box" invisible="not frontend_chatbot_enabled">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="frontend_chatbot_position">Position</label>
                                <field name="frontend_chatbot_position"/>
                                <div class="text-muted">
                                    Where to display the chatbot button
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
