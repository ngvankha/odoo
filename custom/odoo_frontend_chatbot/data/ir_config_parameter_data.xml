<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Enable frontend chatbot by default -->
        <record id="frontend_chatbot_enabled" model="ir.config_parameter">
            <field name="key">odoo_frontend_chatbot.enabled</field>
            <field name="value">True</field>
        </record>
        
        <!-- Default welcome message -->
        <record id="frontend_chatbot_welcome_message" model="ir.config_parameter">
            <field name="key">odoo_frontend_chatbot.welcome_message</field>
            <field name="value">Hello! I'm your Odoo assistant. How can I help you today? 👋</field>
        </record>
        
        <!-- Chatbot position (bottom-right by default) -->
        <record id="frontend_chatbot_position" model="ir.config_parameter">
            <field name="key">odoo_frontend_chatbot.position</field>
            <field name="value">bottom-right</field>
        </record>
    </data>
</odoo>
