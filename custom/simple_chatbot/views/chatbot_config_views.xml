<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form view -->
        <record id="view_chatbot_config_form" model="ir.ui.view">
            <field name="name">simple.chatbot.config.form</field>
            <field name="model">simple.chatbot.config</field>
            <field name="arch" type="xml">
                <form string="Chatbot Configuration">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Tên cấu hình..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="n8n_webhook_url" placeholder="https://your-n8n-instance.com/webhook/chatbot"/>
                                <field name="is_active"/>
                            </group>
                            <group>
                                <field name="timeout"/>
                            </group>
                        </group>
                        <div class="oe_chatter">
                            <field name="message_ids"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree view -->
        <record id="view_chatbot_config_tree" model="ir.ui.view">
            <field name="name">simple.chatbot.config.tree</field>
            <field name="model">simple.chatbot.config</field>
            <field name="arch" type="xml">
                <tree string="Chatbot Configurations">
                    <field name="name"/>
                    <field name="n8n_webhook_url"/>
                    <field name="is_active"/>
                    <field name="timeout"/>
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="action_chatbot_config" model="ir.actions.act_window">
            <field name="name">Chatbot Configuration</field>
            <field name="res_model">simple.chatbot.config</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo cấu hình chatbot mới!
                </p>
                <p>
                    Cấu hình webhook URL để kết nối với n8n.
                </p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem
            id="menu_chatbot_root"
            name="Simple Chatbot"
            sequence="100"/>
        
        <menuitem
            id="menu_chatbot_config"
            name="Configuration"
            parent="menu_chatbot_root"
            action="action_chatbot_config"
            sequence="10"/>
    </data>
</odoo>
