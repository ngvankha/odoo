<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <t t-name="simple_chatbot.ChatbotWidget" owl="1">
        <!-- Nút mở chatbot trong systray -->
        <div class="o_simple_chatbot_systray">
            <button class="btn btn-secondary o_simple_chatbot_button" t-on-click="toggleChatbot">
                <i class="fa fa-comments"></i>
                <span class="d-none d-md-inline ms-1">Chatbot</span>
            </button>
        </div>

        <!-- Cửa sổ chatbot -->
        <div t-if="state.isOpen" class="o_simple_chatbot_window">
            <div class="o_simple_chatbot_header">
                <span class="o_simple_chatbot_title">
                    <i class="fa fa-robot me-2"></i>
                    Simple Chatbot
                    <span t-if="!state.isEnabled" class="badge bg-danger ms-2">Tắt</span>
                    <span t-elif="!state.isConfigured" class="badge bg-warning ms-2">Chưa cấu hình</span>
                    <span t-else="" class="badge bg-success ms-2">n8n</span>
                </span>
                <div class="o_simple_chatbot_controls">
                    <button class="btn btn-sm btn-outline-light me-1" t-on-click="refreshConfiguration" title="Làm mới cấu hình">
                        <i class="fa fa-sync"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-light me-1" t-on-click="clearChat" title="Xóa cuộc trò chuyện">
                        <i class="fa fa-refresh"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-light" t-on-click="toggleChatbot" title="Đóng">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
            </div>
            
            <div class="o_simple_chatbot_messages">
                <div t-foreach="state.messages" t-as="message" t-key="message_index" 
                     t-attf-class="o_simple_chatbot_message {{message.isBot ? 'o_bot_message' : 'o_user_message'}} {{message.isError ? 'o_error_message' : ''}} {{message.isLoading ? 'o_loading_message' : ''}}">
                    <div class="o_message_content">
                        <i t-if="message.isBot &amp;&amp; message.isLoading" class="fa fa-spinner fa-spin me-2"></i>
                        <i t-elif="message.isBot &amp;&amp; message.isError" class="fa fa-exclamation-triangle me-2"></i>
                        <i t-elif="message.isBot" class="fa fa-robot me-2"></i>
                        <i t-else="" class="fa fa-user me-2"></i>
                        <span t-esc="message.text"></span>
                    </div>
                    <div t-if="message.timestamp &amp;&amp; !message.isLoading" class="o_message_time">
                        <small t-esc="formatTime(message.timestamp)"></small>
                    </div>
                </div>
            </div>
            
            <div class="o_simple_chatbot_input">
                <div class="input-group">
                    <input type="text" 
                           class="form-control" 
                           placeholder="Nhập tin nhắn của bạn..."
                           t-model="state.currentMessage"
                           t-on-keypress="onKeyPress"
                           t-att-disabled="state.isLoading or !state.isEnabled" />
                    <button class="btn btn-primary" 
                            t-on-click="sendMessage"
                            t-att-disabled="state.isLoading or !state.isEnabled">
                        <i t-if="state.isLoading" class="fa fa-spinner fa-spin"></i>
                        <i t-else="" class="fa fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
