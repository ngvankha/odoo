<odoo>
    <data>
        <record id="view_ai_chatbot_form" model="ir.ui.view">
            <field name="name">ai.chatbot.form</field>
            <field name="model">ai.chatbot</field>
            <field name="arch" type="xml">
                <form string="AI Chatbot">
                    <sheet>
                        <group>
                            <field name="name" placeholder="Ask a question..." />
                            <field name="response" readonly="1" />
                        </group>
                        <footer>
                            <button name="get_ai_response" string="Get Response" type="object"
                                class="btn-primary" />
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_ai_chatbot" model="ir.actions.act_window">
            <field name="name">AI Chatbot</field>
            <field name="res_model">ai.chatbot</field>
            <field name="view_mode">form</field>
        </record>
    </data>
</odoo>